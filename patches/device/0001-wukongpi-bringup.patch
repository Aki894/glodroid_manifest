diff --git a/wukongpi/init.wukongpi.rc b/wukongpi/init.wukongpi.rc
new file mode 100644
index 0000000..936a317
--- /dev/null
+++ b/wukongpi/init.wukongpi.rc
@@ -0,0 +1,13 @@
+# SPDX-License-Identifier: Apache-2.0
+on post-fs
+    # vendor/vendor_dlkm and firmware are now available. Dependencies are built in.
+    insmod /vendor_dlkm/lib/modules/kernel/drivers/net/wireless/xradio/xradio_wlan.ko
+
+on boot
+    # Low-RAM baseline: no disk swap and no repeated flash writes.
+    write /proc/sys/vm/page-cluster 0
+    write /proc/sys/vm/swappiness 100
+
+on property:sys.boot_completed=1
+    # Readiness markers only; do not override accessory mode after an AOA switch.
+    setprop vendor.wukongpi.boot_completed 1
