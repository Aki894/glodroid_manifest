# Dedicated development appliance; SELinux is currently permissive.
# Preserve gadget/AOA ownership for the car.
service wukong_bridge /system/bin/sh /vendor/bin/wukong-bridge.sh
    class main
    user root
    group root system shell bluetooth net_bt net_bt_admin
    disabled
    seclabel u:r:su:s0

on post-fs-data
    setprop persist.wukong.bridge.enabled ${persist.wukong.bridge.enabled:-1}

on property:init.svc.zygote=running && property:persist.wukong.bridge.enabled=1
    start wukong_bridge

on property:sys.boot_completed=1 && property:persist.wukong.bridge.enabled=1
    start wukong_bridge

on property:persist.wukong.bridge.enabled=0
    stop wukong_bridge
